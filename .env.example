# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://tennis:tennis@localhost:5432/grandslam?schema=public"

# --- Auth (NextAuth) --------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# OAuth providers are enabled when their keys are present.
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Magic-link email sign-in, e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=""
EMAIL_FROM=""
# Password-less demo sign-in for local development. Keep "false" in production.
ENABLE_DEMO_LOGIN="true"

# --- Tennis data ------------------------------------------------------------
# "mock" (default, no key needed) or "sportradar".
TENNIS_PROVIDER="mock"
SPORTRADAR_API_KEY=""
# SPORTRADAR_BASE_URL="https://api.sportradar.com/tennis/production/v3/en"
# Season to sync; defaults to the current UTC year.
# SEASON="2026"

# --- Cron -------------------------------------------------------------------
# Cron routes require "Authorization: Bearer $CRON_SECRET" (Vercel Cron sends this).
CRON_SECRET="change-me-too"

# --- Cache ------------------------------------------------------------------
# Redis or Vercel KV connection string. Falls back to in-process memory when unset.
REDIS_URL="redis://localhost:6379"
