// GrandSlam Fantasy data model.
// Auth tables follow the NextAuth Prisma adapter contract.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  memberships   LeagueMember[]
  ownedLeagues  League[]  @relation("LeagueCommissioner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Tennis data (synced from the tennis data provider)
// ---------------------------------------------------------------------------

enum Tour {
  ATP
  WTA
}

enum Surface {
  HARD
  CLAY
  GRASS
}

enum TournamentCategory {
  GRAND_SLAM
  MASTERS_1000
}

enum TournamentStatus {
  UPCOMING
  LIVE
  COMPLETED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  RETIRED
  WALKOVER
}

model Player {
  id           String  @id @default(cuid())
  externalId   String  @unique
  name         String
  tour         Tour
  country      String
  rank         Int
  rankPoints   Int
  // Win percentage on each surface over the trailing 52 weeks (0-1).
  hardWinPct   Float
  clayWinPct   Float
  grassWinPct  Float
  seasonWins   Int     @default(0)
  seasonLosses Int     @default(0)
  // Most recent results first, e.g. "WWLWW". Used for the form component of salary.
  recentForm   String  @default("")
  salary       Float
  updatedAt    DateTime @updatedAt

  entries      TournamentEntry[]
  stats        MatchPlayerStat[]
  rosterSlots  RosterSlot[]

  @@index([tour, rank])
}

model Tournament {
  id         String             @id @default(cuid())
  externalId String             @unique
  name       String
  category   TournamentCategory
  surface    Surface
  // Which tours play this event. Grand Slams and combined Masters events have both.
  tours      Tour[]
  location   String
  season     Int
  // Rosters lock at startsAt.
  startsAt   DateTime
  endsAt     DateTime
  status     TournamentStatus   @default(UPCOMING)
  updatedAt  DateTime           @updatedAt

  entries    TournamentEntry[]
  matches    Match[]
  rosters    Roster[]
  leagues    League[]

  @@index([season, startsAt])
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  playerId     String
  seed         Int?
  eliminated   Boolean    @default(false)

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
}

model Match {
  id           String      @id @default(cuid())
  externalId   String      @unique
  tournamentId String
  tour         Tour
  round        Int         // 1 = first round; the final is the highest round
  roundName    String
  status       MatchStatus @default(SCHEDULED)
  scheduledAt  DateTime
  bestOf       Int         @default(3)
  winnerId     String?
  // Set scores, e.g. [[6,4],[3,6],[7,6]] from player A's perspective.
  score        Json        @default("[]")
  updatedAt    DateTime    @updatedAt

  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stats        MatchPlayerStat[]

  @@index([tournamentId, round])
}

model MatchPlayerStat {
  id                   String  @id @default(cuid())
  matchId              String
  playerId             String
  // Player A is the top line of the draw.
  side                 String  // "A" | "B"
  seed                 Int?
  aces                 Int     @default(0)
  doubleFaults         Int     @default(0)
  breakPointsConverted Int     @default(0)
  setsWon              Int     @default(0)
  setsLost             Int     @default(0)
  // Fantasy points for this player in this match, recomputed on every score poll.
  fantasyPoints        Float   @default(0)
  breakdown            Json    @default("{}")

  match                Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player               Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
}

// ---------------------------------------------------------------------------
// Fantasy
// ---------------------------------------------------------------------------

enum LeagueMode {
  TOURNAMENT
  SEASON
}

enum SeasonFormat {
  HEAD_TO_HEAD
  POINTS
}

enum TourMode {
  ATP
  WTA
  MIXED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

model League {
  id            String        @id @default(cuid())
  name          String
  mode          LeagueMode
  seasonFormat  SeasonFormat  @default(POINTS)
  tourMode      TourMode
  visibility    Visibility    @default(PRIVATE)
  inviteCode    String        @unique
  passcodeHash  String?
  salaryCap     Float         @default(100)
  maxMembers    Int           @default(12)
  season        Int
  // Only set for TOURNAMENT mode leagues.
  tournamentId  String?
  commissionerId String
  createdAt     DateTime      @default(now())

  tournament    Tournament?   @relation(fields: [tournamentId], references: [id])
  commissioner  User          @relation("LeagueCommissioner", fields: [commissionerId], references: [id])
  members       LeagueMember[]

  @@index([visibility, createdAt])
}

model LeagueMember {
  id        String   @id @default(cuid())
  leagueId  String
  userId    String
  teamName  String
  joinedAt  DateTime @default(now())

  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rosters   Roster[]

  @@unique([leagueId, userId])
}

enum SlotType {
  STARTER
  CAPTAIN
  BENCH
}

model Roster {
  id           String       @id @default(cuid())
  memberId     String
  tournamentId String
  updatedAt    DateTime     @updatedAt

  member       LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  slots        RosterSlot[]

  @@unique([memberId, tournamentId])
}

model RosterSlot {
  id        String   @id @default(cuid())
  rosterId  String
  playerId  String
  slot      SlotType
  // Salary at the time the player was picked, so later price moves don't break the cap.
  salary    Float

  roster    Roster   @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id])

  @@unique([rosterId, playerId])
}
